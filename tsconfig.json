{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "./dist",
    "paths": {
      "@components/*": ["./src/app/common/components/*"],
      "@design/*": ["./src/app/common/design/*"],
      "@global/*": ["./src/app/common/global/*"],
      "@common/graphql/*": ["./src/app/common/graphql/*"],
      "@app/*": ["./src/app/*"],
      "@assets/*": ["./src/assets/*"],
      "@graphql": ["./src/generated/graphql/gql"],
      "@graphql/types": ["./src/generated/graphql/graphql"],
      "@typechain": ["./src/generated/typechain"],
      "@typechain/*": ["./src/generated/typechain/*"],
      "@hoc/*": ["./src/hoc/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@styles/*": ["./src/styles/*"],
      "@utils/*": ["./src/utils/*"]
    },
    "removeComments": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020",
    "types": ["vite/client"]
  },
  "include": ["./src", "./codegen.ts", "./vite.config.ts"]
}
