{
  "name": "tokenzyme-app",
  "version": "1.0.0",
  "packageManager": "yarn@4.9.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "format": "prettier --write './**/*.{ts,tsx,cts,mts,js,cjs,mjs,json,yml,yaml}'",
    "graphql:generate": "graphql-codegen",
    "image:build": "set -a && . ./.env && set +a && docker buildx build --platform=linux/amd64 --provenance=false --build-arg VITE_CORE_URL --build-arg VITE_INDEXER_URL --build-arg VITE_REOWN_PROJECT_ID --build-arg VITE_NETWORK --build-arg VITE_RPC_URL --build-arg VITE_BLOCK_EXPLORER_URL --build-arg VITE_LAUNCHPAD_ADDRESS -t \"${DOCKER_IMAGE:-tokenzyme-app:latest}\" .",
    "image:publish": "docker push \"${DOCKER_IMAGE:-tokenzyme-app:latest}\"",
    "lint": "eslint .",
    "start:dev": "vite",
    "start:preview": "vite preview",
    "start:prod": "serve -s dist -p 3001"
  },
  "dependencies": {
    "@apollo/client": "3.14.1",
    "@fontsource-variable/red-hat-display": "5.3.0",
    "@hookform/resolvers": "5.5.7",
    "@reown/appkit": "1.8.23",
    "@reown/appkit-adapter-ethers": "1.8.23",
    "@tabler/icons-react": "3.45.0",
    "@tanstack/react-query": "5.101.4",
    "date-fns": "4.4.0",
    "ethers": "6.17.0",
    "graphql": "16.14.2",
    "jotai": "2.20.2",
    "lightweight-charts": "5.2.0",
    "lodash.snakecase": "4.1.1",
    "primereact": "10.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "react-router": "7.18.1",
    "serve": "14.2.6",
    "socket.io-client": "4.8.3",
    "type-fest": "4.41.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "5.0.7",
    "@graphql-codegen/client-preset": "4.8.3",
    "@graphql-typed-document-node/core": "3.2.0",
    "@types/lodash.snakecase": "4.1.9",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react-swc": "4.3.2",
    "autoprefixer": "10.5.4",
    "eslint": "8.57.1",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "9.1.2",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-deprecation": "2.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.5.3",
    "postcss": "8.5.23",
    "postcss-import": "16.1.1",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "5.1.4"
  }
}
