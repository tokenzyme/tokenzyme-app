# Copy this file to .env and fill in the values.
#
#   cp .env.template .env
#
# .env is git-ignored. Every variable here is required — src/utils/env.ts throws at
# startup if one is missing.
#
# These are Vite variables: they are read at BUILD time and inlined into the bundle.
# Nothing here is secret, because everything here is shipped to the browser. Never
# put a private key or an API secret in this file.

# ---------------------------------------------------------------------------
# Backend services
# ---------------------------------------------------------------------------

# tokenzyme-core — GraphQL API and its comments WebSocket.
VITE_CORE_URL="http://localhost:3000"

# tokenzyme-indexer — trades and price WebSocket.
VITE_INDEXER_URL="http://localhost:3002"

# ---------------------------------------------------------------------------
# Wallet connection
# ---------------------------------------------------------------------------

# Reown (formerly WalletConnect) project ID, from https://dashboard.reown.com.
# Create your own — the ID is tied to an account with allowlisted domains, and it
# ends up visible in the bundle either way. Free tier is enough for development.
VITE_REOWN_PROJECT_ID=""

# ---------------------------------------------------------------------------
# Blockchain
# ---------------------------------------------------------------------------
# All four must describe the same network, and must match what tokenzyme-core and
# tokenzyme-indexer are pointed at. Uncomment one block.

# Local fork (chain ID 1337) — run `yarn test:fork:startNode` in tokenzyme-contracts
VITE_NETWORK="fork"
VITE_RPC_URL="http://127.0.0.1:8545"
VITE_BLOCK_EXPLORER_URL="https://sonicscan.org"
VITE_LAUNCHPAD_ADDRESS=""

# Sonic mainnet (chain ID 146)
# VITE_NETWORK="mainnet"
# VITE_RPC_URL="https://rpc.soniclabs.com"
# VITE_BLOCK_EXPLORER_URL="https://sonicscan.org"
# VITE_LAUNCHPAD_ADDRESS="0x9E23D1354E30C2274D3f0Ae2D70c9324081A6E4c"

# Sonic testnet (chain ID 14601)
# VITE_NETWORK="testnet"
# VITE_RPC_URL="https://rpc.testnet.soniclabs.com"
# VITE_BLOCK_EXPLORER_URL="https://testnet.sonicscan.org"
# VITE_LAUNCHPAD_ADDRESS="0xcafD49ea48EFa63e94a8392Bb78924Ed1a26e702"

# Sonic Blaze testnet (chain ID 57054, legacy)
# VITE_NETWORK="testnet-legacy"
# VITE_RPC_URL="https://rpc.blaze.soniclabs.com"
# VITE_BLOCK_EXPLORER_URL="https://blaze.soniclabs.com"
# VITE_LAUNCHPAD_ADDRESS="0x9E23D1354E30C2274D3f0Ae2D70c9324081A6E4c"
